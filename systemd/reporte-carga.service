[Unit]
Description=Reporte diario Previsión de Carga (ERP ATENEA2)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Ajusta User y rutas a tu instalación real:
User=reportes
WorkingDirectory=/opt/reporte-carga
ExecStart=/opt/reporte-carga/.venv/bin/python /opt/reporte-carga/report.py
# Las variables se leen del .env vía python-dotenv; alternativamente:
# EnvironmentFile=/opt/reporte-carga/.env
