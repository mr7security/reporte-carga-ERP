# === Base de datos (ERP ATENEA2 / BBDD GRUPO) ===
DB_SERVER=10.0.1.1
DB_NAME=GRUPO
DB_USER=
DB_PASSWORD=
DB_PORT=1433
DB_TDS_VERSION=7.4
DB_READONLY=true          # ApplicationIntent=ReadOnly (necesario para réplicas secundarias AlwaysOn)

# === Correo saliente (SMTP) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls          # starttls | ssl | none
SMTP_USER=                 # vacío si el relay no pide auth
SMTP_PASS=
MAIL_FROM=reportes@serviplana.es

# === Dashboard (app web) ===
APP_PORT=8070
APP_PASSWORD=              # contraseña para entrar al panel (OBLIGATORIA)
APP_SECRET=                # cadena larga aleatoria para las sesiones
